; ControllerTT — 手柄摇杆训练器
;
; 参数说明见 docs/architecture.md。修改本文件前请注意：
; 物理与渲染帧率会直接影响手感测量，改动前先确认你知道自己在做什么。

config_version=5

[application]

config/name="ControllerTT 手柄摇杆训练器"
config/description="面向 FPS 的手柄摇杆熟练度训练工具，可调死区、响应曲线与辅助瞄准。"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
; 关掉启动图。训练器启动很快，闪一下 Godot 标志反而显得像没做完。
boot_splash/show_image=false
boot_splash/bg_color=Color(0.05, 0.06, 0.08, 1)

[autoload]

App="*res://game/app_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0

[physics]

; 本项目不使用物理引擎：命中判定走 core/aim/hit_test.gd 的解析求交，
; 玩家位移直接在渲染帧积分。这样整条视角链路都不必等物理帧，输入延迟最低。
common/physics_ticks_per_second=60
common/physics_interpolation=false

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.06, 0.07, 0.09, 1)
